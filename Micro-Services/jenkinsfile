@Library('jenkins-shared-library')
def gv
pipeline{
    agent any 
    stages{
        stage('init'){
            steps{
                script{
                    gv = load"Micro-Services/script.groovy"
                }
            }
        }
        stage('test'){
            steps{
                script {
               gv.test()
                }
            }
        }
        stage('Build Image'){
            steps{
                script {
               buildImage()
                }
            }
        }
        stage('Login To Docker Hub'){
            steps{
                script {
                dockerLogin()
                }
            }
        }
        stage('Push Images'){
            steps{
                script {
                pushImage()
                }
             
            }
        }
    }
}