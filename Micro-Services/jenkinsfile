// iugfciygugiohk

def gv
pipeline{
    agent any 
    stages{
        stage('init'){
            steps{
                script{
                    gv = load"Micro-Services/script.groovy"
                }
            }
        }
        stage('test'){
            steps{
                script {
                echo "testing....stage"
               gv.test()
                }
            }
        }
        stage('Increment Version'){
            steps{
                 script{
                    gv.incrementVersion()
                }
            }
        }
        stage('Build Image'){
            steps{
                script {
               gv.buildImage()
                }
            }
        }
        stage('Login To Docker Hub'){
            steps{
                script {
                gv.dockerLogin()
                }
            }
        }
        stage('Push Images'){
            steps{
                script {
                gv.pushImage()
                }
             
            }
        }
        stage('Push Version Update'){
            steps{
                script{
                    gv.pushVersionUpdate()
                }
            }
        }
    }
}
